          },
          "expr": "topk(10, sum by (method, path) (rate(http_requests_total{namespace=~\"$namespace\", job=~\"$job\"}[5m])))",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
