      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_request_duration_seconds_bucket{namespace=~\"$namespace\", job=~\"$job\"}[5m])))",
          "legendFormat": "p50",
          "range": true
        },
        {
          "refId": "B",
