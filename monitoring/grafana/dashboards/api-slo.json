        "x": 0,
        "y": 24,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "Top endpoints by traffic (5m)",
      "id": 12,
      "description": "",
      "datasource": {
        "type": "prometheus",
